name: Android Automatic APK Build

on:
  push:
    branches: [ "main", "master" ]
  pull_request:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build:
    name: Build & Export APK Artifacts
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.13'

      - name: Locate Android project root
        id: find_root
        run: |
          # Some export/upload tools nest the whole project one or more
          # folders deep (e.g. inside "_extracted") instead of placing it
          # at the repo root. Find wherever settings.gradle.kts actually
          # ended up and use that as the project root for every later step.
          PROJECT_DIR=$(dirname "$(find "$GITHUB_WORKSPACE" -maxdepth 5 -name 'settings.gradle.kts' | head -n 1)")
          if [ -z "$PROJECT_DIR" ] || [ ! -d "$PROJECT_DIR" ]; then
            echo "::error::Could not find settings.gradle.kts anywhere in the checked-out repo."
            exit 1
          fi
          echo "Found Android project at: $PROJECT_DIR"
          echo "dir=$PROJECT_DIR" >> "$GITHUB_OUTPUT"

      - name: Prepare Keystore & Environment
        working-directory: ${{ steps.find_root.outputs.dir }}
        run: |
          chmod +x gradlew 2>/dev/null || true
          if [ -f debug.keystore.base64 ]; then
            base64 -d debug.keystore.base64 > debug.keystore || base64 --decode debug.keystore.base64 > debug.keystore
          elif [ ! -f debug.keystore ]; then
            # No keystore was committed to the repo, so generate the standard
            # Android debug keystore on the fly. This uses the same well-known
            # alias/passwords the debugConfig signingConfig in app/build.gradle.kts
            # expects, so assembleDebug can always sign the APK.
            keytool -genkeypair -v \
              -keystore debug.keystore \
              -storepass android \
              -alias androiddebugkey \
              -keypass android \
              -keyalg RSA -keysize 2048 -validity 10000 \
              -dname "CN=Android Debug,O=Android,C=US"
          fi
          if [ ! -f .env ]; then
            cp .env.example .env 2>/dev/null || touch .env
          fi

      - name: Build Debug APK with Gradle
        working-directory: ${{ steps.find_root.outputs.dir }}
        run: gradle assembleDebug --stacktrace

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: IntergalacticStudio-APK
          path: ${{ steps.find_root.outputs.dir }}/app/build/outputs/apk/debug/app-debug.apk
